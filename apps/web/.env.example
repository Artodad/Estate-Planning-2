# === AI (Grok / xAI) ===
GROK_API_KEY=xai-...

# === Document storage ===
# Local / isolated verify: disk under apps/web/.local-document-storage (default).
# Production (Vercel): private object storage. Force disk only off Vercel:
# DOCUMENT_STORAGE=disk
# Do not commit store tokens. Configure the production Blob store in the Vercel dashboard.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Emails ===
RESEND_API_KEY=re_...

# === Optional: Inngest ===
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# === Error Monitoring (Sentry) — Wave C production hardening ===
# Get from Sentry project settings. Required for production error tracking + source maps.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=estate-planning-engine
SENTRY_AUTH_TOKEN=sntrys_xxx  # For source map upload in CI / Vercel (keep secret)

