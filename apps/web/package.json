{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "tsx --test src/features/documents/mapper.test.ts src/features/documents/intake-to-fill.test.ts src/features/documents/upload-normalize-pipeline.test.ts src/features/dashboard/server/upload-template-action.test.ts src/features/documents/soft-suggestion-accept-reject.test.ts src/features/documents/template-normalize/*.test.ts src/features/intake/machine.test.ts",
    "test:unit": "tsx --test src/features/documents/mapper.test.ts src/features/documents/intake-to-fill.test.ts src/features/documents/upload-normalize-pipeline.test.ts src/features/dashboard/server/upload-template-action.test.ts src/features/documents/soft-suggestion-accept-reject.test.ts src/features/documents/template-normalize/*.test.ts src/features/intake/machine.test.ts",
    "test:unit:intake-fill": "tsx --test src/features/documents/mapper.test.ts src/features/documents/intake-to-fill.test.ts",
    "test:unit:normalize": "tsx --test src/features/documents/template-normalize/*.test.ts",
    "test:unit:upload-normalize": "tsx --test src/features/documents/upload-normalize-pipeline.test.ts src/features/documents/soft-suggestion-accept-reject.test.ts src/features/documents/template-normalize/prepare-template-upload.test.ts src/features/documents/template-normalize/apply-accepted-suggestions.test.ts src/features/dashboard/server/upload-template-action.test.ts",
    "normalize-template": "tsx scripts/normalize-template.ts",
    "normalize-trust-corpus": "tsx scripts/normalize-trust-corpus.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.1",
    "@clerk/ui": "^1.13.1",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/ui": "workspace:*",
    "@sentry/nextjs": "^10.54.0",
    "@tanstack/react-query": "^5.100.14",
    "@xstate/react": "^6.1.0",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "docxtemplater": "^3.68.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.0",
    "pg": "^8.21.0",
    "pizzip": "^3.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.76.1",
    "resend": "^6.12.4",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.31.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.33",
    "@next/eslint-plugin-next": "^16.2.0",
    "@playwright/test": "^1.60.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.1",
    "postcss": "^8.5.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.5",
    "tsx": "^4.22.3",
    "typescript": "5.9.2"
  }
}
