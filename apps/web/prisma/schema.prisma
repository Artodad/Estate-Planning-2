generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  role      String
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id])
  createdAt DateTime @default(now())
}
