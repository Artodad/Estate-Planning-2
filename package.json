{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "pnpm --filter web test:unit",
    "test:unit": "pnpm --filter web test:unit",
    "test:unit:intake-fill": "pnpm --filter web test:unit:intake-fill",
    "test:unit:upload-normalize": "pnpm --filter web test:unit:upload-normalize",
    "test:unit:fidelity-smoke": "pnpm --filter web test:unit:fidelity-smoke",
    "test:unit:fidelity-corpus": "pnpm --filter web test:unit:fidelity-corpus",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@parcel/watcher",
      "@prisma/engines",
      "@sentry/cli",
      "bufferutil",
      "core-js",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "utf-8-validate"
    ]
  }
}
